{
  "manifest_version": 3,
  "name": "Mac Voice Control Bridge",
  "version": "0.1.0",
  "description": "Permission-scoped semantic browser control for Mac Voice Control.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
